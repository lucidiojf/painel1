<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Emissão AIH Oficial</title>
  <!-- Biblioteca para gerar PDF diretamente no dispositivo móvel -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      background-color: #f1f5f9;
      color: #1e293b;
      padding: 16px;
    }

    .container {
      max-width: 860px;
      margin: 0 auto;
      background: #ffffff;
      padding: 24px;
      border-radius: 8px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    header.app-header {
      border-bottom: 2px solid #0284c7;
      padding-bottom: 12px;
      margin-bottom: 20px;
      text-align: center;
    }

    header.app-header h1 {
      font-size: 1.3rem;
      color: #0369a1;
      text-transform: uppercase;
    }

    header.app-header h2 {
      font-size: 1rem;
      font-weight: normal;
      color: #475569;
    }

    fieldset {
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      padding: 16px;
      margin-bottom: 16px;
    }

    legend {
      padding: 0 8px;
      font-weight: bold;
      color: #0284c7;
      font-size: 0.95rem;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .form-group.col-full {
      grid-column: 1 / -1;
    }

    label {
      font-size: 0.8rem;
      font-weight: 600;
      margin-bottom: 4px;
      color: #334155;
    }

    input, select, textarea {
      width: 100%;
      padding: 8px 10px;
      border: 1px solid #94a3b8;
      border-radius: 4px;
      font-size: 0.9rem;
      background: #fff;
    }

    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: #0284c7;
      box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.2);
    }

    .btn-principal {
      display: block;
      width: 100%;
      background: #0284c7;
      color: #ffffff;
      border: none;
      padding: 14px;
      font-size: 1.05rem;
      font-weight: bold;
      border-radius: 6px;
      cursor: pointer;
      margin-top: 10px;
      transition: background 0.2s;
    }

    .btn-principal:hover {
      background: #0369a1;
    }

    /* Modal de Pré-visualização */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(15, 23, 42, 0.75);
      z-index: 9999;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 10px;
    }

    .modal-janela {
      background: #e2e8f0;
      width: 100%;
      max-width: 900px;
      max-height: 96vh;
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
    }

    .modal-cabecalho {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #ffffff;
      padding: 12px 18px;
      border-bottom: 2px solid #cbd5e1;
      flex-wrap: wrap;
      gap: 10px;
    }

    .modal-titulo {
      font-size: 1.1rem;
      font-weight: bold;
      color: #0f172a;
    }

    .modal-botoes {
      display: flex;
      gap: 8px;
    }

    .btn-modal {
      border: none;
      border-radius: 4px;
      padding: 8px 14px;
      font-size: 0.85rem;
      font-weight: bold;
      color: #fff;
      cursor: pointer;
    }

    .btn-imprimir { background: #0284c7; }
    .btn-pdf { background: #0369a1; }
    .btn-fechar { background: #ef4444; }

    .modal-conteudo-scroll {
      padding: 16px;
      overflow-y: auto;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      display: flex;
      justify-content: center;
      background: #64748b;
    }

    /* Estilo de Folha A4 Oficial */
    .folha-documento {
      background: #ffffff;
      width: 100%;
      min-width: 680px;
      max-width: 800px;
      padding: 24px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.2);
      font-family: Arial, Helvetica, sans-serif;
      font-size: 11px;
      color: #000;
    }

    .folha-cabecalho {
      text-align: center;
      border-bottom: 2px solid #000;
      padding-bottom: 8px;
      margin-bottom: 10px;
    }

    .folha-cabecalho h3 {
      font-size: 13px;
      margin-bottom: 2px;
      text-transform: uppercase;
    }

    .folha-cabecalho h4 {
      font-size: 11px;
      margin-bottom: 2px;
    }

    .folha-cabecalho p {
      font-size: 10px;
    }

    .folha-titulo {
      font-size: 13px;
      font-weight: bold;
      text-align: center;
      background: #e2e8f0;
      border: 1px solid #000;
      padding: 4px;
      margin-bottom: 6px;
      text-transform: uppercase;
    }

    .tabela-aih {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 6px;
    }

    .tabela-aih td, .tabela-aih th {
      border: 1px solid #000;
      padding: 4px 6px;
      vertical-align: top;
    }

    .tag-campo {
      font-size: 8.5px;
      font-weight: bold;
      text-transform: uppercase;
      color: #333;
      display: block;
      margin-bottom: 2px;
    }

    .conteudo-campo {
      font-size: 11px;
      font-weight: 600;
      color: #000;
    }

    /* Regras de Impressão */
    @media print {
      body * {
        visibility: hidden;
      }
      #folhaAihImpressao, #folhaAihImpressao * {
        visibility: visible;
      }
      #folhaAihImpressao {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        min-width: 100%;
        padding: 0;
        box-shadow: none;
      }
      .modal-overlay, .modal-janela, .modal-conteudo-scroll {
        position: static;
        background: transparent;
        overflow: visible;
      }
      .modal-cabecalho {
        display: none !important;
      }
    }
  </style>
</head>
<body>

  <div class="container">
    <header class="app-header">
      <h1>Emissão AIH Oficial</h1>
      <h2>Hospital Maternidade Severina Carlos de Andrade &bull; Frutuoso Gomes - RN</h2>
    </header>

    <form id="formAIH" onsubmit="event.preventDefault(); gerarVisualizacao();">
      
      <!-- Dados de Identificação -->
      <fieldset>
        <legend>1. Dados do Estabelecimento e Registo</legend>
        <div class="form-grid">
          <div class="form-group">
            <label>Nº do Prontuário</label>
            <input type="text" id="prontuario" required placeholder="Ex: 7521">
          </div>
          <div class="form-group">
            <label>Nº da AIH (se houver)</label>
            <input type="text" id="num_aih" placeholder="Opcional">
          </div>
          <div class="form-group">
            <label>Tipo</label>
            <select id="tipo_aih">
              <option value="01 - Inicial">01 - Inicial</option>
              <option value="02 - Continuidade">02 - Continuidade</option>
            </select>
          </div>
          <div class="form-group">
            <label>Data Admissão/Internação</label>
            <input type="date" id="data_admissao" required>
          </div>
          <div class="form-group">
            <label>Data de Saída / Alta</label>
            <input type="date" id="data_saida">
          </div>
        </div>
      </fieldset>

      <!-- Dados do Paciente -->
      <fieldset>
        <legend>2. Dados do Paciente</legend>
        <div class="form-grid">
          <div class="form-group col-full">
            <label>Nome Completo do Paciente</label>
            <input type="text" id="paciente" required placeholder="Nome do paciente">
          </div>
          <div class="form-group">
            <label>Cartão SUS (CNS)</label>
            <input type="text" id="cns" placeholder="000 0000 0000 0000">
          </div>
          <div class="form-group">
            <label>Data de Nascimento</label>
            <input type="date" id="nascimento">
          </div>
          <div class="form-group">
            <label>Sexo</label>
            <select id="sexo">
              <option value="F">Feminino</option>
              <option value="M">Masculino</option>
            </select>
          </div>
          <div class="form-group">
            <label>Raça / Cor</label>
            <select id="raca">
              <option value="PARDA">Parda</option>
              <option value="BRANCA">Branca</option>
              <option value="PRETA">Preta</option>
              <option value="AMARELA">Amarela</option>
              <option value="INDIGENA">Indígena</option>
            </select>
          </div>
          <div class="form-group col-full">
            <label>Nome da Mãe</label>
            <input type="text" id="mae" placeholder="Nome completo da mãe">
          </div>
          <div class="form-group col-full">
            <label>Endereço Completo</label>
            <input type="text" id="endereco" placeholder="Rua, número, bairro ou sítio">
          </div>
          <div class="form-group">
            <label>Município</label>
            <input type="text" id="municipio" value="Frutuoso Gomes">
          </div>
          <div class="form-group">
            <label>UF</label>
            <input type="text" id="uf" value="RN">
          </div>
          <div class="form-group">
            <label>Telefone</label>
            <input type="text" id="telefone" placeholder="(84) 90000-0000">
          </div>
        </div>
      </fieldset>

      <!-- Dados Clínicos e Procedimento -->
      <fieldset>
        <legend>3. Procedimento e Justificativa Clínica</legend>
        <div class="form-grid">
          <div class="form-group">
            <label>Especialidade / Clínica</label>
            <input type="text" id="especialidade" value="CLÍNICA MÉDICA">
          </div>
          <div class="form-group">
            <label>Leito / Enfermaria</label>
            <input type="text" id="leito" value="01">
          </div>
          <div class="form-group">
            <label>CID-10 Principal</label>
            <input type="text" id="cid" required placeholder="Ex: D23 ou I10">
          </div>
          <div class="form-group">
            <label>Diagnóstico Inicial</label>
            <input type="text" id="diagnostico" required placeholder="Ex: Outras neoplasias benignas da pele">
          </div>
          <div class="form-group">
            <label>Código do Procedimento</label>
            <input type="text" id="cod_procedimento" placeholder="Ex: 0401020045">
          </div>
          <div class="form-group col-full">
            <label>Descrição do Procedimento Solicitado</label>
            <input type="text" id="procedimento" placeholder="Ex: EXCISAO E ENXERTO DE PELE">
          </div>
          <div class="form-group col-full">
            <label>Sinais e Sintomas Clínicos / Histórico</label>
            <textarea id="sintomas" rows="2" placeholder="Descreva os sintomas e histórico..."></textarea>
          </div>
          <div class="form-group col-full">
            <label>Condições que Justificam a Internação</label>
            <textarea id="justificativa" rows="2" placeholder="Descreva a justificação clínica...">Quadro clínico com necessidade de intervenção e acompanhamento hospitalar.</textarea>
          </div>
        </div>
      </fieldset>

      <!-- Solicitante -->
      <fieldset>
        <legend>4. Profissional Solicitante</legend>
        <div class="form-grid">
          <div class="form-group col-full">
            <label>Nome do Médico Solicitante</label>
            <input type="text" id="medico" value="LUCÍDIO JÁCOME FERREIRA">
          </div>
          <div class="form-group">
            <label>CPF do Solicitante</label>
            <input type="text" id="cpf_medico" value="175.499.574-87">
          </div>
        </div>
      </fieldset>

      <button type="submit" class="btn-principal">Gerar e Visualizar AIH</button>
    </form>
  </div>

  <!-- Modal de Pré-visualização -->
  <div id="modalAIH" class="modal-overlay" style="display: none;">
    <div class="modal-janela">
      
      <!-- Cabeçalho com Ações -->
      <div class="modal-cabecalho">
        <div class="modal-titulo">Visualização da AIH Gerada</div>
        <div class="modal-botoes">
          <button type="button" class="btn-modal btn-imprimir" onclick="imprimirAIH()">Imprimir</button>
          <button type="button" class="btn-modal btn-pdf" onclick="descarregarPDF()">Baixar PDF</button>
          <button type="button" class="btn-modal btn-fechar" onclick="fecharModal()">Fechar</button>
        </div>
      </div>

      <!-- Área de Documento -->
      <div class="modal-conteudo-scroll">
        <div id="folhaAihImpressao" class="folha-documento"></div>
      </div>

    </div>
  </div>

  <script>
    // Formatar data AAAA-MM-DD para DD/MM/AAAA
    function formatarData(dataStr) {
      if (!dataStr) return '';
      const partes = dataStr.split('-');
      if (partes.length === 3) {
        return `${partes[2]}/${partes[1]}/${partes[0]}`;
      }
      return dataStr;
    }

    function gerarVisualizacao() {
      const prontuario = document.getElementById('prontuario').value;
      const numAih = document.getElementById('num_aih').value;
      const tipoAih = document.getElementById('tipo_aih').value;
