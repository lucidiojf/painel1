            <td>
              <span class="tag-campo">Telefone</span>
              <span class="conteudo-campo">${telefone || '&nbsp;'}</span>
            </td>
          </tr>
          <tr>
            <td colspan="3">
              <span class="tag-campo">Endereço Residencial</span>
              <span class="conteudo-campo">${endereco} - ${municipio}/${uf}</span>
            </td>
          </tr>
        </table>

        <div class="folha-titulo" style="margin-top: 8px;">Dados Clínicos e Justificativa de Internação</div>

        <table class="tabela-aih">
