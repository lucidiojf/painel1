      const endereco = document.getElementById('endereco').value;
      const municipio = document.getElementById('municipio').value;
      const uf = document.getElementById('uf').value;
      const telefone = document.getElementById('telefone').value;
      const especialidade = document.getElementById('especialidade').value;
      const leito = document.getElementById('leito').value;
      const cid = document.getElementById('cid').value;
      const diagnostico = document.getElementById('diagnostico').value;
      const codProcedimento = document.getElementById('cod_procedimento').value;
      const procedimento = document.getElementById('procedimento').value;
      const sintomas = document.getElementById('sintomas').value;
      const justificativa = document.getElementById('justificativa').value;
      const medico = document.getElementById('medico').value;
      const cpfMedico = document.getElementById('cpf_medico').value;

      const htmlDocumento = `
        <div class="folha-cabecalho">
          <h3>Prefeitura Municipal de Frutuoso Gomes</h3>
          <h4>Hospital Maternidade Severina Carlos de Andrade</h4>
          <p>CNPJ: 08.349.052/0001-80 &bull; Frutuoso Gomes - RN</p>
        </div>

        <div class="folha-titulo">Autorização para Internação Hospitalar (AIH)</div>

        <table class="tabela-aih">
          <tr>
            <td style="width: 70%;">
              <span class="tag-campo">1 - Estabelecimento Solicitante / Executante</span>
              <span class="conteudo-campo">HOSPITAL MATERNIDADE SEVERINA CARLOS DE ANDRADE</span>
            </td>
            <td style="width: 30%;">
              <span class="tag-campo">2 - CNES</span>
              <span class="conteudo-campo">2380846</span>
            </td>
          </tr>
          <tr>
            <td>
              <span class="tag-campo">Número da AIH</span>
              <span class="conteudo-campo">${numAih || '&nbsp;'}</span>
            </td>
            <td>
              <span class="tag-campo">Prontuário</span>
              <span class="conteudo-campo">${prontuario}</span>
            </td>
          </tr>
          <tr>
            <td>
              <span class="tag-campo">Tipo de AIH</span>
              <span class="conteudo-campo">${tipoAih}</span>
            </td>
            <td>
              <span class="tag-campo">Período de Atendimento</span>
              <span class="conteudo-campo">${dataAdmissao} a ${dataSaida || 'Em aberto'}</span>
            </td>
          </tr>
        </table>

        <div class="folha-titulo" style="margin-top: 8px;">Dados do Paciente</div>
        
        <table class="tabela-aih">
          <tr>
            <td colspan="2" style="width: 70%;">
              <span class="tag-campo">Nome do Paciente</span>
              <span class="conteudo-campo">${paciente}</span>
            </td>
            <td style="width: 30%;">
              <span class="tag-campo">Cartão SUS (CNS)</span>
              <span class="conteudo-campo">${cns || '&nbsp;'}</span>
            </td>
          </tr>
          <tr>
            <td style="width: 35%;">
              <span class="tag-campo">Data de Nascimento</span>
              <span class="conteudo-campo">${nascimento || '&nbsp;'}</span>
            </td>
            <td style="width: 20%;">
              <span class="tag-campo">Sexo</span>
              <span class="conteudo-campo">${sexo}</span>
            </td>
            <td style="width: 45%;">
              <span class="tag-campo">Raça / Cor</span>
              <span class="conteudo-campo">${raca}</span>
            </td>
          </tr>
          <tr>
            <td colspan="2">
              <span class="tag-campo">Nome da Mãe</span>
